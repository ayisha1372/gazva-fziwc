# ---------- Server ----------
NODE_ENV=development
PORT=4000

# ---------- MongoDB ----------
# Local:  mongodb://127.0.0.1:27017/gazva
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/gazva?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gazva

# ---------- Auth ----------
# REQUIRED. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h

# ---------- CORS / URLs ----------
# Comma-separated list of browser origins allowed to call the API with cookies.
# In production (client served by this server) this is just your site URL.
CLIENT_URL=http://localhost:5173

# ---------- First-run accounts (used by `npm run seed`) ----------
# Admin: full CMS access.  Viewer: can open the protected Wing / Club / Class Union rankings.
# Passwords are bcrypt-hashed in the database. Change them straight after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisAdminPassword!1
VIEWER_USERNAME=rankings
VIEWER_PASSWORD=ChangeThisViewerPassword!1

# ---------- Misc ----------
# Events are scheduled in this UTC offset when deciding Upcoming / Ongoing / Completed.
EVENT_TZ_OFFSET=+05:30
# Where uploaded images are stored (relative to /server or absolute). Mount a persistent disk here in production.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
